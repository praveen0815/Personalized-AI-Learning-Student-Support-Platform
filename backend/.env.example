# Embedding provider: "local" (fastembed, no API key) or "openai" (OpenAI-compatible HTTP API).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Required when EMBEDDING_PROVIDER=openai. Leave blank for the local provider.
EMBEDDING_API_KEY=
# Used only by the openai provider. Override for an OpenAI-compatible server.
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Must match the selected model. bge-small-en-v1.5 is 384. text-embedding-3-small is 1536.
EMBEDDING_DIMENSION=384

# PostgreSQL with the pgvector extension. The password below is the local Docker default.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/learning_kb

CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# 20 MB
MAX_UPLOAD_BYTES=20971520
UPLOAD_DIR=uploads
EMBEDDING_TIMEOUT_SECONDS=60

# Tutor language model. openai calls an OpenAI-compatible chat API. mock does not call a network API.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
# Drop retrieved chunks below this cosine similarity. They are not sent to the model.
TUTOR_MIN_SIMILARITY=0.55

# Explainable mastery weights. They must sum to 1.
MASTERY_PRIOR_WEIGHT=0.7
MASTERY_CURRENT_WEIGHT=0.3
LEARNING_GAP_THRESHOLD=60
LEARNING_GAP_MEDIUM_FLOOR=50
ADAPTIVE_EASY_BELOW=40
ADAPTIVE_HARD_AT=70
ASSESSMENT_MAX_GENERATION_ATTEMPTS=2

# Browser origins allowed to call the API. Comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
