# Learning API the browser calls. No secrets belong in this file.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Existing Government Scheme Eligibility Predictor. The Student Support page forwards
# profiles to this service and does not score eligibility itself. Port 8000 is the learning API.
SCHEME_API_BASE_URL=http://127.0.0.1:8001

# Development only. Create a student with POST /api/v1/students and paste that id here.
# Leave blank to use the one-time "Create development student" action in the dashboard.
# That action stores the id in this browser and does not create another student on refresh.
NEXT_PUBLIC_DEMO_STUDENT_ID=
